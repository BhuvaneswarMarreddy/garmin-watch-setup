<?xml version="1.0" encoding="UTF-8"?>
<!--
    A Connect IQ DATA FIELD (type="datafield"). Unlike a watch face, this shows
    up inside activities (run, bike, etc.) as one of the data boxes on screen.
    Targets the Venu 3 family.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="63016479c06b4659878e73e78fd1f801"
        type="datafield"
        name="@Strings.AppName"
        entry="HeartRateFieldApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <iq:products>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
        </iq:products>

        <iq:permissions/>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
