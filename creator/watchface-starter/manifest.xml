<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ application manifest.
    Normally the VS Code "Monkey C" extension generates this for you when you run
    "Monkey C: New Project". This one is pre-filled and targets the Venu 3 family.
    The "id" below is a unique app id generated for this project.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="59b10eee7e2241c195f758f04b16fd92"
        type="watchface"
        name="@Strings.AppName"
        entry="VenuWatchFaceApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <!-- Target devices. venu3 = 454x454 AMOLED, venu3s = 390x390 AMOLED. -->
        <iq:products>
            <iq:product id="venu3"/>
            <iq:product id="venu3s"/>
        </iq:products>

        <!-- This simple face needs no special permissions. -->
        <iq:permissions/>

        <!-- Supported languages. -->
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
